# ==============================================================================
# API Gateway Environment Variables
# ==============================================================================
# Copy to .env and fill in the values. Never commit real secrets.
# ==============================================================================

# --- Database ---------------------------------------------------------------
DB_HOST=database
DB_USER=user
DB_PASSWORD=user
DB_NAME=motzklist_db
DB_SSLMODE=disable

# --- CORS -------------------------------------------------------------------
# Comma-separated list of browser origins allowed to call the API with
# credentials (the public Front-End). The Admin Front-End proxies server-side
# and does not need to be listed here.
CLIENT_ORIGIN=http://localhost:3000

# --- Payments (Stripe) ------------------------------------------------------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
FRONTEND_URL=http://localhost:3000

# --- Third-party sign-in (OAuth) --------------------------------------------
# Client credentials per provider, named {PROVIDER}_CLIENT_ID / _SECRET. Obtain
# these from the provider's console (e.g. Google Cloud -> Credentials -> OAuth
# client). Only needed for the providers you actually enable on the frontends
# (NEXT_PUBLIC_AUTH_PROVIDER=google, etc.).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=

# This gateway's public base URL, used to build the OAuth redirect_uri that the
# provider calls back (must be reachable by the user's browser and registered as
# an authorized redirect URI in the provider console). Defaults to the request
# host when unset. In Google's console, authorize:
#   {PUBLIC_API_URL}/api/auth/google/callback
PUBLIC_API_URL=http://localhost:8080

# Dev mode: when true, /api/auth/{provider}/start and /exchange skip the real
# identity provider and log in OAUTH_DEV_EMAIL, so the full redirect + session
# flow is testable locally without any real OAuth credentials. NEVER enable in
# production.
OAUTH_DEV_MODE=false
OAUTH_DEV_EMAIL=dev.oauth@motzklist.local
